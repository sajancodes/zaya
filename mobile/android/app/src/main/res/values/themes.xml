<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only: this is the phone's side of a dark dashboard. -->
    <style name="Theme.Zaya.Base" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zaya_background</item>
        <item name="android:colorBackground">@color/zaya_background</item>
        <item name="android:statusBarColor">@color/zaya_background</item>
        <item name="android:navigationBarColor">@color/zaya_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Zaya" parent="Theme.Zaya.Base" />

    <style name="Theme.Zaya.Call" parent="Theme.Zaya">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
