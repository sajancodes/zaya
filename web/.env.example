# Zaya Web Backend Environment Configuration
# Copy this file to .env and configure your production values.

# Database file path or SQLite URL
DATABASE_URL=sqlite:///./data/zaya_analytics.db

# Owner Admin Dashboard Credentials
ADMIN_USER=owner
ADMIN_PASSWORD=change_this_to_a_secure_password_in_production!

# Public Base URL
ZAYA_WEBSITE_URL=https://zaya.sajan.codes
ZAYA_TELEMETRY_URL=https://zaya.sajan.codes

# Server binding
HOST=0.0.0.0
PORT=8000
