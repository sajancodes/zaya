# Zaya Web Backend Environment Configuration
# Copy this file to .env and configure your production values.

# Database file path or SQLite URL
ZAYA_DATABASE_BACKEND=firebase
FIREBASE_PROJECT_ID=zaya-c502a
# Set FIREBASE_SERVICE_ACCOUNT_JSON as a sensitive server-only Vercel variable.
# Do not place its value in this file or in VITE_* variables.

# Owner Admin Dashboard Credentials
# ADMIN_PASSWORD must be at least 12 characters and not use known defaults. Without this, /admin is disabled.
ADMIN_USER=owner
ADMIN_PASSWORD=

# Public Base URL
ZAYA_WEBSITE_URL=https://zaya.sajan.codes
ZAYA_TELEMETRY_URL=https://zaya.sajan.codes

# Server binding
HOST=0.0.0.0
PORT=8000
