# Zaya — created by Sajan Rai — local files excluded from the repository.
# Everything listed here is created by the app on first run. A fresh clone with
# none of it present boots straight to the setup screen, which is the intended
# first experience — so nothing here needs to be committed, and some of it must
# never be.

# ── Secrets. Committing any of these publishes them. ──────────────────────────
# your Gemini API key, plus per-plugin credentials
config/api_keys.json
# the dashboard's TLS private key and certificate
config/certs/
# a LINKED WhatsApp session — committing it hands
config/whatsapp_web/
                              # somebody your WhatsApp account, not just a key
# Google OAuth tokens (Gmail / Calendar plugins)
**/token*.json
# Google OAuth client secrets
**/client_secret*.json
*credentials*.json
.env
.env.*

# ── Personal data the assistant accumulates about you ─────────────────────────
memory/long_term.json
memory/*.db

# ── Python build noise ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Editors and operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime output ────────────────────────────────────────────────────────────
*.log
logs/
downloads/
screenshots/

# Local tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.benchmarks/

# Private operator state
*.keystore
*.jks
config/.zaya-config-*.tmp
memory/projects.json
memory/coding_jobs.json
memory/coding_jobs.tmp
memory/missions.json
memory/missions.tmp
memory/*_state.json
memory/*_state.tmp
zayabar.tmp
assets/zayabar/
memory/backups/
memory/projects.tmp
memory/profile*.json
memory/*.db-*
config/hermes*.json
.hermes/

# Downloaded installers are local artifacts
plugins/*.exe
config/hermes_pairing*
config/hermes_connection.tmp

# Generated docs, research dossiers, widgets and local calendar data
docs/generated/
docs/research/
dashboard/widgets/
data/
.jdk/
.gradle_home/
memory/calendar_events.json
memory/spatial_cache/
spatial_renderer/node_modules/
spatial_renderer/dist/
models/hand_landmarker.task
.venv-hands/
memory/spatial_session.json
memory/spatial_session.tmp
memory/spatial_assets.db*
config/hand_controls.json
